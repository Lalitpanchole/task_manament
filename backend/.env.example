# Application Environment & Port Configuration
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-site.netlify.app

# Production Remote MySQL Connection String Format
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# JWT Authentication Secret Key
JWT_SECRET="your_production_secure_jwt_secret_key_2026"
JWT_EXPIRATION=7d


