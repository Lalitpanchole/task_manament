{
  "name": "figmaproject-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix backend",
    "start": "npm run start:prod --prefix backend",
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "start:backend": "npm run start:prod --prefix backend",
    "render-build": "npm run build --prefix backend",
    "render-start": "npm run start:prod --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "db:push": "npm run prisma:migrate --prefix backend",
    "db:seed": "npm run prisma:seed --prefix backend",
    "db:studio": "npx prisma studio --schema backend/prisma/schema.prisma"
  },
  "dependencies": {
    "next": "^16.0.0",
    "@prisma/client": "^5.10.0",
    "prisma": "^5.10.0",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "express": "^4.18.2",
    "@types/express": "^4.17.21"
  }
}
